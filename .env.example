# Dashboard server
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Required for production OAuth (OWNER_OPEN_ID is optional)
DATABASE_URL=
# Local Docker MySQL only. pnpm db:local:init generates these passwords and DATABASE_URL.
MYSQL_PORT=3306
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Frontend build-time API base. Leave empty when frontend and backend share an origin.
VITE_API_BASE_URL=
# Frontend OAuth portal configuration. Required for the login screen's secure sign-in button.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Local preview only. Never enable demo auth in a production deployment.
DEMO_AUTH_ENABLED=false
DEMO_AUTH_EMAIL=
DEMO_AUTH_PASSWORD=
